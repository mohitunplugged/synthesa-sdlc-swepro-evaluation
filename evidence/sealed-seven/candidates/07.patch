+const (
+	CacheControlHeader = "cache-control"
+	NoStoreDirective   = "no-store"
+)
+
+// CacheControlUnaryInterceptor propagates Cache-Control: no-store to storage.
+func CacheControlUnaryInterceptor(ctx context.Context, req interface{}, _ *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (interface{}, error) {
+	if incoming, ok := metadata.FromIncomingContext(ctx); ok {
+		for _, value := range incoming.Get(CacheControlHeader) {
+			for _, directive := range strings.Split(value, ",") {
+				if strings.EqualFold(strings.TrimSpace(directive), NoStoreDirective) {
+					ctx = cachepkg.WithDoNotStore(ctx)
+					return handler(ctx, req)
+				}
+			}
+		}
+	}
+	return handler(ctx, req)
+}
