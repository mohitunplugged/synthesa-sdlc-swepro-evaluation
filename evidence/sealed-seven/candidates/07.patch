+type doNotStoreContextKey struct{}
+
+// WithDoNotStore marks cache operations in ctx as read/write bypasses.
+func WithDoNotStore(ctx context.Context) context.Context {
+	return context.WithValue(ctx, doNotStoreContextKey{}, true)
+}
+
+// IsDoNotStore reports whether cache reads and writes must be bypassed.
+func IsDoNotStore(ctx context.Context) bool {
+	value, ok := ctx.Value(doNotStoreContextKey{}).(bool)
+	return ok && value
+}
